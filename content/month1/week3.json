  "listenings": [
    {
      "id": "d1",
      "kind": "dialog",
      "title": "Кофе с собой",
      "speakers": [
        { "id": "barista", "name": "Barista", "voice": "woman1" },
        { "id": "anna", "name": "Anna", "voice": "anna" }
      ],
      "lines": [
        { "speaker": "barista", "text": "Hi, what can I get you?", "ru": "Здравствуйте, что будете заказывать?" },
        { "speaker": "anna", "text": "Can I have a large latte, please?", "ru": "Можно мне большой латте?" },
        { "speaker": "barista", "text": "Sure. Regular milk or oat milk?", "ru": "Конечно. На обычном молоке или на овсяном?" },
        { "speaker": "anna", "text": "Oat milk, please. And a croissant.", "ru": "На овсяном, пожалуйста. И круассан." },
        { "speaker": "barista", "text": "Is that to eat in or take away?", "ru": "Здесь или с собой?" },
        { "speaker": "anna", "text": "Take away, please. How much is it?", "ru": "С собой, пожалуйста. Сколько с меня?" },
        { "speaker": "barista", "text": "That's six pounds fifty.", "ru": "Шесть фунтов пятьдесят." }
      ],
      "questions": [
        { "q": "What drink does Anna order?", "options": ["A small latte", "A large latte", "A large cappuccino"], "correct": 1, "explainRu": "«Can I have a large latte, please?» — большой латте." },
        { "q": "What milk does she want?", "options": ["Oat milk", "Regular milk", "No milk"], "correct": 0, "explainRu": "Ей предлагают «regular milk or oat milk», и она выбирает «Oat milk» — овсяное." },
        { "q": "Where will she have her coffee?", "options": ["At a table in the café", "She takes it away", "At the bar"], "correct": 1, "explainRu": "На вопрос «to eat in or take away?» она отвечает «Take away» — берёт с собой." },
        { "q": "How much is it?", "options": ["Six pounds fifteen", "Sixteen pounds fifty", "Six pounds fifty"], "correct": 2, "explainRu": "«That's six pounds fifty» — £6.50. Fifty (50) и fifteen (15) различаются ударением." }
      ]
    },
    {
      "id": "d2",
      "kind": "dialog",
      "title": "В ресторане",
      "speakers": [
        { "id": "waiter", "name": "Waiter", "voice": "man1" },
        { "id": "anna", "name": "Anna", "voice": "anna" }
      ],
      "lines": [
        { "speaker": "waiter", "text": "Good evening. Do you have a reservation?", "ru": "Добрый вечер. У вас забронировано?" },
        { "speaker": "anna", "text": "No, we don't. Do you have a table for two?", "ru": "Нет. У вас есть столик на двоих?" },
        { "speaker": "waiter", "text": "Yes, follow me, please. Here's the menu.", "ru": "Да, пройдёмте, пожалуйста. Вот меню." },
        { "speaker": "anna", "text": "What do you recommend?", "ru": "Что вы посоветуете?" },
        { "speaker": "waiter", "text": "The fish of the day is very good.", "ru": "Рыба дня очень хорошая." },
        { "speaker": "waiter", "text": "It comes with salad and potatoes.", "ru": "Её подают с салатом и картофелем." },
        { "speaker": "anna", "text": "I'll have that. Could we have some tap water too?", "ru": "Я возьму её. И можно нам воды из-под крана?" },
        { "speaker": "anna", "text": "Could we have the bill, please? Can I pay by card?", "ru": "Можно нам счёт, пожалуйста? Можно заплатить картой?" },
        { "speaker": "waiter", "text": "Yes, of course. I'll bring the card machine.", "ru": "Да, конечно. Я принесу терминал." }
      ],
      "questions": [
        { "q": "Do they have a reservation?", "options": ["Yes, they do", "No, they don't", "We don't know"], "correct": 1, "explainRu": "Anna отвечает: «No, we don't» — брони нет, поэтому она спрашивает про столик на двоих." },
        { "q": "What does the waiter recommend?", "options": ["Pasta", "Steak", "The fish of the day"], "correct": 2, "explainRu": "«The fish of the day is very good» — официант советует рыбу дня." },
        { "q": "What does the fish come with?", "options": ["Salad and potatoes", "Rice and vegetables", "Bread and soup"], "correct": 0, "explainRu": "«It comes with salad and potatoes» — с салатом и картофелем." },
        { "q": "How does Anna want to pay?", "options": ["By card", "In cash", "By phone"], "correct": 0, "explainRu": "«Can I pay by card?» — картой. Официант обещает принести терминал (card machine)." }
      ]
    },
    {
      "id": "d3",
      "kind": "announcement",
      "title": "Распродажа в магазине одежды",
      "speakers": [
        { "id": "speaker", "name": "Announcement", "voice": "announcer" },
        { "id": "anna", "name": "Anna", "voice": "anna" },
        { "id": "assistant", "name": "Shop assistant", "voice": "woman2" }
      ],
      "lines": [
        { "speaker": "speaker", "text": "Good afternoon, shoppers.", "ru": "Добрый день, уважаемые покупатели." },
        { "speaker": "speaker", "text": "Today, all jackets and coats are thirty percent off.", "ru": "Сегодня на все куртки и пальто скидка тридцать процентов." },
        { "speaker": "anna", "text": "Excuse me, do you have this jacket in a smaller size?", "ru": "Простите, есть эта куртка на размер меньше?" },
        { "speaker": "assistant", "text": "What size do you need?", "ru": "Какой размер вам нужен?" },
        { "speaker": "anna", "text": "A medium, please.", "ru": "Средний, пожалуйста." },
        { "speaker": "assistant", "text": "Here you are. The fitting rooms are over there.", "ru": "Пожалуйста. Примерочные вон там." },
        { "speaker": "anna", "text": "It fits well. Is it on sale?", "ru": "Хорошо сидит. Она со скидкой?" },
        { "speaker": "assistant", "text": "Yes, it's thirty percent off today.", "ru": "Да, сегодня на неё скидка тридцать процентов." },
        { "speaker": "anna", "text": "Great, I'll take it.", "ru": "Отлично, беру." }
      ],
      "questions": [
        { "q": "What does Anna buy?", "options": ["A dress", "A jacket", "A coat"], "correct": 1, "explainRu": "Она спрашивает про «this jacket» — куртку. Пальто (coats) звучат только в объявлении о скидке." },
        { "q": "What size does she need?", "options": ["Small", "Large", "Medium"], "correct": 2, "explainRu": "«A medium, please» — средний размер." },
        { "q": "How big is the discount?", "options": ["Thirty percent", "Thirteen percent", "Fifty percent"], "correct": 0, "explainRu": "«Thirty percent off» — скидка 30%. В thirty ударение в начале: THIRty, в thirteen — в конце: thirTEEN." }
      ]
    },
    {
      "id": "d4",
      "kind": "dialog",
      "title": "В аптеке",
      "speakers": [
        { "id": "anna", "name": "Anna", "voice": "anna" },
        { "id": "pharmacist", "name": "Pharmacist", "voice": "man2" }
      ],
      "lines": [
        { "speaker": "anna", "text": "Hello. I have a headache and a sore throat.", "ru": "Здравствуйте. У меня болит голова и горло." },
        { "speaker": "pharmacist", "text": "Do you have a temperature?", "ru": "Температура есть?" },
        { "speaker": "anna", "text": "No, I don't think so.", "ru": "Нет, кажется, нет." },
        { "speaker": "pharmacist", "text": "Take these tablets twice a day, after meals.", "ru": "Принимайте эти таблетки два раза в день, после еды." },
        { "speaker": "pharmacist", "text": "And these are for your throat.", "ru": "А эти — для горла." },
        { "speaker": "anna", "text": "Thank you. How much is it altogether?", "ru": "Спасибо. Сколько всего?" },
        { "speaker": "pharmacist", "text": "Eight pounds twenty, please.", "ru": "Восемь фунтов двадцать, пожалуйста." }
      ],
      "questions": [
        { "q": "What is Anna's problem?", "options": ["A stomach ache", "A headache and a sore throat", "A bad back"], "correct": 1, "explainRu": "«I have a headache and a sore throat» — болят голова и горло." },
        { "q": "How often should she take the tablets?", "options": ["Twice a day", "Three times a day", "Once a day"], "correct": 0, "explainRu": "«Take these tablets twice a day» — два раза в день." },
        { "q": "When should she take them?", "options": ["Before meals", "After meals", "Only at night"], "correct": 1, "explainRu": "«…twice a day, after meals» — после еды." },
        { "q": "How much is it altogether?", "options": ["Eighteen pounds", "Two pounds eighty", "Eight pounds twenty"], "correct": 2, "explainRu": "«Eight pounds twenty» — £8.20. Eighteen (18) звучит похоже на eight (8), но длиннее и с ударением на конце." }
      ]
    }
  ],
